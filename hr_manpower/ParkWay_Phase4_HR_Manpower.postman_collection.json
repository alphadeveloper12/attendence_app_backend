{
  "info": {
    "name": "ParkWay Phase 4 – HR, Manpower & Camp APIs",
    "description": "Complete API collection for Phase 4: HR Administration, Camp Management, Attendance & Manpower Planning. Base URL: http://127.0.0.1:8001/api/hr/",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8001", "type": "string" },
    { "key": "token", "value": "YOUR_JWT_ACCESS_TOKEN_HERE", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "0. Auth – Get Token",
      "item": [
        {
          "name": "Admin Login (Get JWT Token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@parkway.com\",\n  \"password\": \"yourpassword\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/attendance/admin/login/", "host": ["{{base_url}}"], "path": ["api", "attendance", "admin", "login", ""] }
          }
        }
      ]
    },

